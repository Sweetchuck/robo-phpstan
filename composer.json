{
    "type": "robo-tasks",
    "name": "sweetchuck/robo-phpstan",
    "description": "Robo tasks for PHPStan",
    "keywords": [
        "robo-tasks",
        "phpstan"
    ],
    "authors": [
        {
            "name": "Andor",
            "role": "Maintainer",
            "homepage": "https://github.com/Sweetchuck"
        }
    ],
    "homepage": "https://github.com/Sweetchuck/robo-phpstan",
    "support": {
        "source": "https://github.com/Sweetchuck/robo-phpstan",
        "issues": "https://github.com/Sweetchuck/robo-phpstan/issues"
    },
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "sweetchuck/git-hooks": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "repositories": {
        "nuvoleweb/robo-config": {
            "type": "github",
            "url": "https://github.com/Sweetchuck/robo-config.git"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "consolidation/robo": "^5.0",
        "nette/neon": "^3.4",
        "sweetchuck/lint-report": "1.x-dev",
        "symfony/filesystem": "^7.2",
        "symfony/string": "^7.2"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "nuvoleweb/robo-config": "4.x-dev",
        "phpmd/phpmd": "^2.11",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.5",
        "sweetchuck/codeception-module-robo-task-runner": "4.x-dev",
        "sweetchuck/git-hooks": "2.x-dev",
        "sweetchuck/robo-git": "4.x-dev",
        "sweetchuck/robo-phpcs": "4.x-dev",
        "sweetchuck/robo-phpmd": "4.x-dev",
        "symfony/error-handler": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Sweetchuck\\Robo\\Phpstan\\": "src/"
        }
    },
    "suggest": {
        "phpstan/phpstan": "A phpstan executable is required."
    },
    "autoload-dev": {
        "psr-4": {
            "Sweetchuck\\Robo\\Phpstan\\Tests\\Acceptance\\": "tests/acceptance/",
            "Sweetchuck\\Robo\\Phpstan\\Tests\\Unit\\": "tests/unit/",
            "Sweetchuck\\Robo\\Phpstan\\Tests\\": "tests/_support/"
        },
        "files": [
            "RoboFile.php"
        ]
    },
    "scripts": {
        "clean": [
            "@clean:composer",
            "@clean:codecept"
        ],
        "clean:composer": [
            "rm --recursive --force ./vendor/"
        ],
        "clean:codecept": [
            "git clean --force -X -- ./tests/"
        ]
    }
}
